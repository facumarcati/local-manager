<a href="/taxes" class="back-link">← Volver a gastos</a>
<header class="page-header">
  <div>
    <span class="eyebrow">Gastos y servicios</span>
    <h1>Cargar un gasto</h1>
    <p>Una sola factura, aunque corresponda a varios locales.</p>
  </div>
</header>
<form method="post" action="/taxes" class="form-card">
  <label class="checkbox-card personal-expense"
    ><input
      type="checkbox"
      name="isPersonal"
      value="1"
      data-personal-expense
    /><span
      >Gasto personal<small
        >Servicio o impuesto propio, sin asociarlo a un local.</small
      ></span
    ></label
  >
  <fieldset data-expense-locals>
    <legend>¿A qué locales corresponde?</legend>
    <p class="field-help">
      El importe se registra una sola vez. No se cobra a los inquilinos.
    </p>
    <button type="button" class="text-button" data-select-all>
      Seleccionar todos
    </button>
    <div class="checkbox-grid">
      {{#each locals }}<label class="checkbox-card"
        ><input name="locals" type="checkbox" value="{{_id}}" /><span
          >{{name}}<small>{{address}}</small></span
        ></label
      >{{/each}}
    </div>
    {{#unless locals.length}}
    <p class="field-help">
      No hay locales cargados. Marcá “Gasto personal” o agregá un local antes de
      guardar.
    </p>
    {{/unless}}
  </fieldset>
  <div class="form-grid">
    <div>
      <label for="type">Servicio o impuesto</label
      ><select id="type" name="type" required>
        <option value="">Elegir…</option>
        <option>Agua</option>
        <option>Gas</option>
        <option>Luz</option>
        <option>ABL</option>
        <option>Municipal</option>
        <option>Ingresos Brutos</option>
        <option>Otro</option>
      </select>
    </div>
    <div>
      <label for="amount">Importe total de la factura</label>
      <div class="input-money">
        <span>$</span
        ><input
          id="amount"
          name="amount"
          type="number"
          min="0.01"
          step="0.01"
          required
        />
      </div>
    </div>
    <div>
      <label for="period">Período facturado</label
      ><input
        id="period"
        name="period"
        placeholder="Ej.: octubre 2026 o 4.º bimestre"
        required
      />
    </div>
    <div>
      <label for="dueDate">Fecha de vencimiento</label
      ><input id="dueDate" type="date" name="dueDate" required />
      <p class="field-help">
        Puede ser una fecha anterior para completar el historial.
      </p>
    </div>
    <div class="full-width">
      <label for="notes">Notas <span class="optional">(opcional)</span></label
      ><textarea
        id="notes"
        name="notes"
        rows="3"
        placeholder="Número de factura, proveedor o aclaraciones"
      ></textarea>
    </div>
  </div>
  <div class="form-actions">
    <a class="btn btn--secondary" href="/taxes">Cancelar</a
    ><button class="btn btn--primary" type="submit">Guardar gasto</button>
  </div>
</form>
