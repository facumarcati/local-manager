<header class="page-header">
  <div>
    <span class="eyebrow">Propiedades</span>
    <h1>Mis locales</h1>
    <p>Los datos de tus locales y quién los alquila.</p>
  </div>
  <a href="/locals/new" class="btn btn--primary">+ Agregar local</a>
</header>
<div class="local-grid">
  {{#each locals}}
  <article class="card local-card">
    <span class="local-symbol">▦</span>
    <h2>{{name}}</h2>
    <p>{{address}}</p>
    <div class="local-tenant">
      {{#if tenantName}}<span class="badge badge--green">Alquilado</span>
      <p>{{tenantName}}</p>
      {{else}}<span class="badge badge--gray">Sin contrato activo</span>{{/if}}
    </div>
    <div class="form-actions">
      <a class="btn btn--secondary" href="/locals/edit/{{_id}}">Editar datos</a
      >{{#unless tenantName}}<a class="btn btn--primary" href="/contracts/new"
        >Cargar contrato</a
      >{{/unless}}
    </div>
    <details>
      <summary>Más opciones</summary>
      <form
        action="/locals/delete/{{_id}}"
        method="post"
        data-confirm="Se eliminará este local si todavía no tiene historial asociado."
      >
        <button class="btn btn--danger" type="submit">
          Eliminar local sin historial
        </button>
      </form>
    </details>
  </article>
  {{else}}
  <section class="card empty-state full-width">
    <span class="empty-icon">▦</span>
    <h2>Agregá tu primer local</h2>
    <p>
      Empezá por el nombre y la dirección. Después podés cargar contratos
      actuales o anteriores.
    </p>
    <a class="btn btn--primary" href="/locals/new">+ Agregar local</a>
  </section>
  {{/each}}
</div>
