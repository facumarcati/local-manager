<header class="page-header">
  <div>
    <span class="eyebrow">Alquileres</span>
    <h1>
      Contratos {{#if (eq view 'history')}}anteriores{{else}}activos{{/if}}
    </h1>
    <p>Fechas, alquileres y cuotas de cada inquilino.</p>
  </div>
  <a class="btn btn--primary" href="/contracts/new">+ Cargar contrato</a>
</header>
<nav class="tab-nav" aria-label="Filtrar contratos">
  <a
    class="tab-item {{#if (eq view 'active')}}tab-item--active{{/if}}"
    href="/contracts"
    >Activos</a
  ><a
    class="tab-item {{#if (eq view 'history')}}tab-item--active{{/if}}"
    href="/contracts/history"
    >Anteriores</a
  >
</nav>
<div class="payment-list">
  {{#each contracts}}
  <article class="card contract-card">
    <div>
      <span class="eyebrow">{{local.name}}</span>
      <h2>{{tenantName}}</h2>
      <p>{{formatDate startDate}} al {{formatDate endDate}}</p>
    </div>
    <div>
      <span class="stat-label">Alquiler de referencia</span
      ><strong class="contract-amount">$ {{formatMoney baseRent}}</strong
      ><small>Vencimiento: día {{paymentDay}} de cada mes</small>
    </div>
    <div class="form-actions">
      <a class="btn btn--secondary" href="/contracts/edit/{{_id}}"
        >Editar fechas</a
      ><a class="btn btn--secondary" href="/contracts/adjust/{{_id}}"
        >Ajustar alquiler</a
      >
    </div>
    <details class="full-width">
      <summary>Otras acciones</summary>
      <div class="form-actions">
        <form
          action="/contracts/regenerate/{{_id}}"
          method="post"
          data-confirm="Se completarán únicamente las cuotas faltantes. Se conservarán todos los cobros y cuotas existentes."
        >
          <button class="btn btn--secondary" type="submit">
            Completar cuotas faltantes
          </button>
        </form>
        {{#if (eq status 'active')}}
        <form
          action="/contracts/finish/{{_id}}"
          method="post"
          data-confirm="El contrato pasará al historial y el local quedará disponible. Las cuotas y deudas seguirán registradas; corregí la fecha de fin antes si el contrato terminó anticipadamente."
        >
          <button class="btn btn--danger" type="submit">
            Finalizar contrato
          </button>
        </form>
        {{/if}}
      </div>
    </details>
  </article>
  {{else}}
  <section class="card empty-state">
    <h2>
      No hay contratos {{#if (eq view
      'history')}}anteriores{{else}}activos{{/if}}
    </h2>
    <p>
      Podés registrar un contrato actual o uno que ya terminó para reconstruir
      el historial.
    </p>
    <a class="btn btn--primary" href="/contracts/new">Cargar contrato</a>
  </section>
  {{/each}}
</div>
