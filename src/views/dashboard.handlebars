<div id="dashboard-content">
  <header class="page-header">
    <div>
      <h1>Inicio</h1>
      <p>Estado de los alquileres y gastos de tus locales.</p>
    </div>
    <div class="header-actions">
      <a class="btn btn--secondary" href="/payments">Ver cobros</a
      ><a class="btn btn--primary" href="/taxes/new">Cargar gasto</a>
    </div>
  </header>
  <div class="overview-toolbar">
    <h2>Resumen del mes</h2>
    <div class="period-selector">
      <a
        data-month-link
        href="/?year={{prevYear}}&month={{prevMonth}}"
        aria-label="Mes anterior"
        >←</a
      ><strong>{{monthName month}} {{year}}</strong
      ><a
        data-month-link
        href="/?year={{nextYear}}&month={{nextMonth}}"
        aria-label="Mes siguiente"
        >→</a
      ><a data-month-link href="/" class="period-today">Mes actual</a>
    </div>
  </div>
  <p class="month-feedback" role="alert" hidden></p>
  <div class="stats-grid">
    <article class="stat-card">
      <span class="stat-label">Alquileres cobrados</span
      ><strong class="stat-value">$ {{formatMoney collected}}</strong
      ><span class="stat-help">Cobros recibidos en el mes</span>
    </article>
    <article class="stat-card">
      <span class="stat-label">Gastos pagados</span
      ><strong class="stat-value">$ {{formatMoney paidExpenses}}</strong
      ><span class="stat-help">Servicios e impuestos abonados</span>
    </article>
    <article class="stat-card">
      <span class="stat-label">Saldo del mes</span
      ><strong class="stat-value">$ {{formatMoney net}}</strong
      ><span class="stat-help">Cobros menos gastos</span>
    </article>
  </div>
  {{#unless hasLocals}}
  <section class="setup-panel">
    <div>
      <h2>Agregá el primer local</h2>
      <p>Podés empezar con los datos actuales o reconstruir el historial.</p>
      <a class="btn btn--primary" href="/locals/new">Agregar local</a>
    </div>
    <ol class="setup-steps">
      <li>
        <strong>Locales</strong
        ><span>Nombre y dirección de cada propiedad.</span>
      </li>
      <li>
        <strong>Contratos</strong
        ><span>Inquilino, alquiler y fechas del contrato.</span>
      </li>
      <li>
        <strong>Cobros y gastos</strong
        ><span>Movimientos con su fecha real.</span>
      </li>
    </ol>
  </section>
  {{/unless}}
  <section class="card section-space">
    <div class="card-header">
      <div>
        <h2>Alquileres con deuda vencida</h2>
        <p>Situación actual · {{lateCount}} cuotas pendientes</p>
      </div>
      {{#if (gt debt 0)}}<strong class="danger">$ {{formatMoney debt}}</strong
      >{{/if}}<a href="/payments">Ver todos</a>
    </div>
    <div class="table-wrap">
      <table class="{{#unless latePayments.length}}table-is-empty{{/unless}}">
        <caption class="sr-only">
          Cuotas vencidas de contratos actuales y anteriores
        </caption>
        <thead>
          <tr>
            <th>Local e inquilino</th>
            <th>Período</th>
            <th>Vencimiento</th>
            <th class="align-right">Falta cobrar</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          {{#each latePayments}}
          <tr>
            <td>
              <strong>{{local.name}}</strong
              ><small>{{contract.tenantName}}</small>
            </td>
            <td>{{periodName period}}</td>
            <td>{{formatDate dueDate}}</td>
            <td class="money align-right danger">
              $ {{formatMoney remaining}}
            </td>
            <td>
              <a class="btn btn--secondary" href="/payments/detail/{{_id}}"
                >Registrar cobro</a
              >
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="table-empty">
              No hay alquileres vencidos por cobrar.
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  <section class="card section-space">
    <div class="card-header">
      <div>
        <h2>Gastos por pagar</h2>
        <p>Ordenados por vencimiento · {{expenseCount}} facturas pendientes</p>
      </div>
      <a href="/taxes">Ver todos</a>
    </div>
    <div class="table-wrap">
      <table
        class="{{#unless upcomingExpenses.length}}table-is-empty{{/unless}}"
      >
        <caption class="sr-only">
          Servicios e impuestos pendientes
        </caption>
        <thead>
          <tr>
            <th>Concepto y locales</th>
            <th>Período</th>
            <th>Vencimiento</th>
            <th class="align-right">Falta pagar</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          {{#each upcomingExpenses}}
          <tr>
            <td><strong>{{type}}</strong><small>{{> expenseLocals}}</small></td>
            <td>{{period}}</td>
            <td class="{{#if overdue}}danger{{/if}}">{{formatDate dueDate}}</td>
            <td class="money align-right">$ {{formatMoney remaining}}</td>
            <td>
              <a class="btn btn--secondary" href="/taxes/detail/{{_id}}"
                >Registrar pago</a
              >
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="5" class="table-empty">
              No hay gastos pendientes de pago.
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{#if hasLocals}}
  <section class="card section-space">
    <div class="card-header">
      <h2>Locales</h2>
      <a href="/locals">Administrar locales</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Local</th>
            <th>Inquilino actual</th>
            <th class="align-right">Deuda vencida</th>
          </tr>
        </thead>
        <tbody>
          {{#each locals}}
          <tr>
            <td><strong>{{name}}</strong><small>{{address}}</small></td>
            <td>
              {{#if tenantName}}{{tenantName}}{{else}}Sin contrato activo{{/if}}
            </td>
            <td class="money align-right {{#if (gt debt 0)}}danger{{/if}}">
              $ {{formatMoney debt}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{/if}}
</div>
