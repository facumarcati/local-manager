<!DOCTYPE html>
<html lang="es" data-page-instance="{{operationId}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <script src="/js/appearance.js"></script>
    <title>Mis locales · Administración</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/app.js" defer></script>
    <script src="/js/navigation.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="app-layout">
      <aside class="sidebar">
        <a class="brand" href="/"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 10h18L19 3H5zM4 10v11h16V10M9 21v-7h6v7" /></svg
          ><span>Mis locales<small>Control de alquileres</small></span></a
        >
        <nav aria-label="Navegación principal">
          <a href="/" class="nav-item {{#if isDashboard}}active{{/if}}"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m3 10 9-7 9 7v10H3z" />
              <path d="M9 20v-7h6v7" />
            </svg>
            Inicio</a
          ><a href="/payments" class="nav-item {{#if isPayments}}active{{/if}}"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 7h16v13H4zM8 3v8m-3-3 3 3 3-3M7 16h10" />
            </svg>
            Cobros</a
          ><a href="/taxes" class="nav-item {{#if isTaxes}}active{{/if}}"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6m-6 4h6" />
            </svg>
            Gastos y servicios</a
          ><a href="/locals" class="nav-item {{#if isLocals}}active{{/if}}"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 10h18L19 3H5zM4 10v11h16V10M9 21v-7h6v7" />
            </svg>
            Locales</a
          ><a
            href="/contracts"
            class="nav-item {{#if isContracts}}active{{/if}}"
            ><svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 3h10l4 4v14H5zM14 3v5h5M8 12h8m-8 4h6" />
            </svg>
            Contratos</a
          >
        </nav>
        <div
          class="appearance-settings"
          aria-label="Preferencias de visualización"
        >
          <label class="preference-switch">
            <span>Modo oscuro</span>
            <input
              class="sr-only"
              type="checkbox"
              role="switch"
              data-theme-switch
            />
            <span class="switch-track" aria-hidden="true"></span>
          </label>
          <label class="preference-switch">
            <span>Texto grande</span>
            <input
              class="sr-only"
              type="checkbox"
              role="switch"
              data-text-switch
            />
            <span class="switch-track" aria-hidden="true"></span>
          </label>
        </div>
      </aside>
      <main id="contenido" class="main-content">
        <div class="topbar">
          <span>Administración de locales</span
          ><time>{{formatDate today}}</time>
        </div>
        <div
          id="navigation-status"
          class="sr-only"
          role="status"
          aria-live="polite"
        ></div>
        <div class="navigation-feedback" role="alert" hidden></div>
        <div class="page-wrapper">
          {{#if saved}}
          <div class="notice success" role="status">
            ✓ Los cambios se guardaron correctamente.
          </div>
          {{/if}}{{{body}}}
        </div>
      </main>
    </div>
    <dialog id="confirm-dialog" aria-labelledby="confirm-title">
      <form method="dialog">
        <span class="eyebrow">Revisar operación</span>
        <h2 id="confirm-title">Confirmar</h2>
        <p id="confirm-message"></p>
        <div class="form-actions">
          <button value="cancel" class="btn btn--secondary">Volver</button
          ><button value="confirm" class="btn btn--primary">Confirmar</button>
        </div>
      </form>
    </dialog>
  </body>
</html>
