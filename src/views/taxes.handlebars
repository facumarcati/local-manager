<header class="page-header">
  <div>
    <span class="eyebrow">Egresos</span>
    <h1>Gastos y servicios</h1>
    <p>Facturas que pagás vos, para uno o varios locales.</p>
  </div>
  <a class="btn btn--primary" href="/taxes/new">+ Cargar gasto</a>
</header>
<nav class="tab-nav" aria-label="Filtrar gastos">
  <a
    href="/taxes"
    class="tab-item {{#unless isHistory}}tab-item--active{{/unless}}"
    >Por pagar</a
  ><a
    href="/taxes?view=history"
    class="tab-item {{#if isHistory}}tab-item--active{{/if}}"
    >Gastos pagados</a
  >
</nav>
<label class="search-field" for="search"
  >Buscar servicio o local<input
    id="search"
    type="search"
    placeholder="Por ejemplo: agua…"
    data-filter=".expense-item"
/></label>
<div class="payment-list">
  {{#each taxes}}
  <article class="card payment-item expense-item">
    <div class="payment-identity">
      <span class="eyebrow">{{period}}</span>
      <h2>{{type}}</h2>
      <p>{{> expenseLocals}}</p>
      {{> status}}
    </div>
    <div class="payment-numbers">
      <div>
        <span>Total de la factura</span
        ><strong>$ {{formatMoney amount}}</strong>
      </div>
      <div>
        <span>Ya pagado</span><strong>$ {{formatMoney paidAmount}}</strong>
      </div>
      <div>
        <span>Falta pagar</span><strong>$ {{formatMoney remaining}}</strong>
      </div>
    </div>
    <div class="payment-action">
      <small>Vence {{formatDate dueDate}}</small
      ><a
        class="btn {{#if (eq status 'paid')}}btn--secondary{{else}}btn--primary{{/if}}"
        href="/taxes/detail/{{_id}}"
        >{{#if (eq status 'paid')}}Ver detalle{{else}}Registrar pago →{{/if}}</a
      >
    </div>
  </article>
  {{else}}
  <section class="card empty-state">
    <span class="empty-icon">✓</span>
    <h2>
      {{#if isHistory}}Todavía no hay gastos pagados{{else}}Sin gastos
      pendientes{{/if}}
    </h2>
    <p>
      Cargá una factura para organizar sus vencimientos y registrar los pagos.
    </p>
    <a class="btn btn--primary" href="/taxes/new">Cargar un gasto</a>
  </section>
  {{/each}}
  <p class="filter-empty" hidden>No hay resultados para esa búsqueda.</p>
</div>
